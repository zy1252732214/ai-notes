{
  "name": "@ai-notes/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri 2 desktop shell for ai-notes.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "tauri": "tauri",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root ."
  },
  "dependencies": {
    "@ai-notes/ai": "workspace:*",
    "@ai-notes/core": "workspace:*",
    "@ai-notes/editor": "workspace:*",
    "@ai-notes/indexer": "workspace:*",
    "@ai-notes/plugin-host": "workspace:*",
    "@ai-notes/plugin-sdk": "workspace:*",
    "@ai-notes/ui": "workspace:*",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
