{
  "name": "@ai-notes/editor",
  "version": "0.0.0",
  "private": true,
  "description": "CodeMirror 6 Markdown editor with wikilinks.",
  "license": "MIT",
  "homepage": "https://github.com/zy1252732214/ai-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zy1252732214/ai-notes.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/zy1252732214/ai-notes/issues"
  },
  "keywords": [
    "ai-notes",
    "codemirror",
    "markdown",
    "wikilinks"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root ."
  },
  "dependencies": {
    "@ai-notes/core": "workspace:*",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
