{
  "name": "@ai-notes/ui",
  "version": "0.0.0",
  "private": true,
  "description": "ai-notes 设计令牌与主题辅助。基础组件后续再加入。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "tokens.css",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/check-tokens.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
