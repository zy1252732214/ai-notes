{
  "name": "@ai-notes/plugin-host",
  "version": "0.0.0",
  "private": true,
  "description": "Sandbox, permission checks, and plugin RPC for ai-notes.",
  "license": "MIT",
  "homepage": "https://github.com/zy1252732214/ai-notes/tree/main/docs/plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zy1252732214/ai-notes.git",
    "directory": "packages/plugin-host"
  },
  "bugs": {
    "url": "https://github.com/zy1252732214/ai-notes/issues"
  },
  "keywords": [
    "ai-notes",
    "plugin",
    "sandbox",
    "permissions"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root ."
  },
  "dependencies": {
    "@ai-notes/core": "workspace:*",
    "@ai-notes/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
