{
  "name": "@ai-notes/plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin API preview v1: types, manifest schema, and the sandbox RPC envelope.",
  "license": "MIT",
  "homepage": "https://github.com/zy1252732214/ai-notes/tree/main/docs/plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zy1252732214/ai-notes.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/zy1252732214/ai-notes/issues"
  },
  "keywords": [
    "ai-notes",
    "plugin",
    "sandbox",
    "rpc"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/manifest.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root ."
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
