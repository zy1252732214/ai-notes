{
  "manifestVersion": 1,
  "apiVersion": "preview-v1",
  "id": "plugin-starter",
  "name": "Plugin Starter",
  "version": "0.1.0",
  "minAppVersion": "0.1.0",
  "author": "ai-notes",
  "description": "模板插件：统计笔记数量，并在侧栏显示。",
  "main": "dist/main.js",
  "permissions": [{ "id": "vault:read" }, { "id": "ui:panel" }],
  "contributes": {
    "commands": [{ "id": "plugin-starter.hello", "name": "示例：统计笔记数量" }],
    "views": [{ "id": "plugin-starter.panel", "name": "示例", "type": "sidebar" }],
    "events": ["note:created"]
  }
}
